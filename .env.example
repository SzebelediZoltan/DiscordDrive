# ---------------------------------------------------------------------------
# DiscordDrive environment reference
#
# Do NOT commit a filled-in copy of this file: it contains the key that encrypts
# every stored webhook URL and the admin password. `.env` is git-ignored.
# Generate a working file with:  ./scripts/setup-env.sh
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Port the frontend is published on (docker-compose.yml).
WEB_PORT=8080

# --- Database ---------------------------------------------------------------
POSTGRES_USER=discorddrive
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=discorddrive
# Connection string for the Prisma CLI and for running the API outside compose.
# The compose `api` service builds its own internal URL from the three values above
# and ignores this one. Needs a Postgres reachable on `localhost:5432`, which means
# running your own instance or temporarily publishing the compose `db` port.
DATABASE_URL=postgresql://discorddrive:change-me-in-production@localhost:5432/discorddrive

# --- Auth -------------------------------------------------------------------
# HS256 signing secret for the session cookie. Minimum 16 characters.
JWT_SECRET=generated-by-setup-env-sh
JWT_TTL_SECONDS=604800
COOKIE_NAME=dd_session
# Set to true whenever the deployment is served over HTTPS.
COOKIE_SECURE=false
# Comma-separated origins allowed to send credentialed requests. Leave empty when
# nginx serves the SPA and the API from one origin (the default setup).
CORS_ORIGINS=

# --- Encryption -------------------------------------------------------------
# AES-256-GCM key (64 hex characters) protecting webhook URLs and bot tokens.
#
# WARNING: rotating this key makes every previously stored webhook URL and bot token
# permanently unreadable. Users would have to re-paste their webhook URL. Back the
# key up somewhere safe before you need it.
APP_ENCRYPTION_KEY=generated-by-setup-env-sh

# --- Admin seed -------------------------------------------------------------
ADMIN_EMAIL=szebe99@gmail.com
ADMIN_PASSWORD=Harkaly88

# --- Chunking ---------------------------------------------------------------
# Size of one file chunk. Capped per webhook by the limit probe (Discord's
# effective webhook attachment ceiling is well below its documented user limit).
CHUNK_SIZE_MIB=8
# Chunks packed into a single Discord message (Discord allows 10 attachments).
# 10 means an 80 MB request, so a 1 GB file is 13 requests instead of 128.
CHUNKS_PER_MESSAGE=10
# Logical ceiling for a single uploaded file.
MAX_FILE_SIZE_MIB=524288

# --- Discord dispatcher -----------------------------------------------------
# In-flight webhook POSTs per webhook. Discord allows 5 requests / 2 s per webhook.
DISCORD_CONCURRENCY=3
# In-flight webhook POSTs across all webhooks, to protect the API process.
DISCORD_GLOBAL_CONCURRENCY=16
# Minimum gap between two POSTs on the same webhook.
DISCORD_MIN_INTERVAL_MS=250
DISCORD_MAX_ATTEMPTS=5

# Bytes each in-flight request may buffer (0 = fully stream through with no buffer).
# Buffering buys retry-ability after a mid-body 429 plus sha256 verification of the
# exact bytes stored. Cost: DISCORD_CONCURRENCY * this value in RAM.
CHUNK_BUFFER_MIB=9

# Scratch directory for optional persisted chunks. Swept on boot and on a timer.
UPLOAD_TMP_DIR=/tmp/discorddrive

# --- Discord endpoint -------------------------------------------------------
# Point at the bundled fake Discord server to run the stack without a real webhook.
DISCORD_API_BASE=https://discord.com/api/v10
FAKE_DISCORD=false
FAKE_DISCORD_PORT=4001
# Simulated CDN link lifetime in seconds. 0 makes links born expired, for tests.
FAKE_DISCORD_LINK_TTL_S=3600
# Token the fake server demands on its bot-authenticated read route.
FAKE_DISCORD_BOT_TOKEN=test-bot-token
